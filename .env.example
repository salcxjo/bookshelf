# Copy this file to .env (which is gitignored) and fill it in. The server reads it at startup.

# Optional. Enables "Will I like this?" and "Books like this".
# A free key comes from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model names change often; if the AI buttons report "model not found",
# pick a current Flash model in AI Studio and put its name here.
# GEMINI_MODEL=gemini-flash-latest

# Optional. An e-mail address or URL, so Open Library knows who is making requests.
# OPENLIBRARY_CONTACT=you@example.com
